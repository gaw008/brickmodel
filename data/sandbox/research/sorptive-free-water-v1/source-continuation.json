    "basis": "excess h,s,f per kg dry matter; partial quantities and Gamma already per mol condensed water; only condensed water enters W",
    "join": "mj=m0(Wj); bj=L0-q0(Wj); hj=L0*(Wj-.8)-integral(q0,.8,Wj); sj=(hj-integral(m0,.8,Wj))/T0; cj=(bj-mj)/T0",
    "positive_low_moisture": "psi=W*ln(W/Wj)-W+Wj; h=hj+bj*(W-Wj); s=sj+cj*(W-Wj)-(R/M)*psi; f=h-T*s",
    "partials": "mu_ex=M*(bj-T*cj)+R*T*ln(W/Wj); partial_h_ex=M*bj; Gamma=R*T/W; aw=aw_join(T)*W/Wj",
    "upper_branch": "exact integration and interpolation of the same represented m0/q0 nodes as the wet model; no refitting or additional observed nodes",
    "zero_inventory": "xlogx(0)=0; h0=hj-bj*Wj; s0=sj-cj*Wj-(R/M)*Wj; f0=h0-T*s0; aw=0; mu and Gamma have explicit infinite-limit labels and null values",
    "reference": "preserve generally nonzero h0/s0; no global reference shift, no formation-enthalpy claim and no permission to discard the dry endpoint excess",
    "excess_heat_capacity_j_kg_dry_k": 0,
    "excess_volume_m3_kg_dry": 0,
    "gamma_join": "distinct left R*T/Wj and right represented-source derivative; not a smooth join"
  },
