      "selected_model": "Finite spherical incompressible Newtonian shell, fixed matrix volume, outer normal traction -p_out, no exterior surface energy, constantT and gamma; closed ideal gas or prescribed pressure venting.",
      "derivation": {
        "velocity": "v(r)=a^2*adot/r^2",
        "normal_stress": "sigma_rr=-p_l-4*eta*a^2*adot/r^3",
        "outer_pressure": "p_l=p_out-4*eta*a^2*adot/S^3",
        "force_balance": "4*eta*(1-phi)*adot/a=p_g-p_out-2*gamma/a",
        "dissipation": "Integral[2*eta*(err^2+2*ett^2)4*pi*r^2 dr,a,S]=16*pi*eta*a*(1-phi)*adot^2",
        "closed_potential": "Phi=gamma*A+p_out*V-n*R*T*ln(V/V_ref)+constant; dPhi/dt=-D",
        "vented_potential": "Omega=gamma*A+(p_out-p_g)*V+constant; dOmega/dt=-D",
        "source_vented_limit": "Whenp_g=p_out, dphi/dt=-3gamma/(2eta*a_i)*(phi_i/(1-phi_i))^(1/3)*phi^(2/3)*(1-phi)^(1/3), WadsworthEq2.12."
      },
      "literal_source_cautions": [
        "Wadsworthp5prose describeszero porosityat infinite time, but its Eq2.12 has an integrable phi^(-2/3) closure time for constant finite positive viscosity. Distinguish prose from the equation actually used.",
