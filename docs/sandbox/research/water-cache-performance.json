  "benchmark_script": "import hashlib,json,statistics,sys,time\nfrom pathlib import Path\nfrom test_rigid_storage import model,DATA\nfrom sludge_sandbox.water_properties import load_water_properties\nfrom sludge_sandbox.phase_storage import InversePolicy\nimport sludge_sandbox.water_properties as module\nrows=[]\nfor iteration in range(3):\n    w=load_water_properties(DATA);m=model(w)\n    target=m.evaluate_at_temperature(300.,2.,{'fixture':.01}).internal_energy_j\n    start=time.perf_counter()\n    out=m.temperature_from_energy(target,2.,{'fixture':.01},(295.,310.),InversePolicy(1e-5,1e-4,100))\n    rows.append(dict(seconds=time.perf_counter()-start,temperature_k=out.state.mechanical.temperature_k,pressure_pa=out.state.mechanical.pressure_pa,energy_residual_j=out.energy_residual_j,temperature_bracket_k=out.final_temperature_bracket_k,iterations=out.iterations))\nresult=dict(water_module=str(Path(module.__file__).resolve()),water_sha256=hashlib.sha256(Path(module.__file__).read_bytes()).hexdigest(),scope='three_unprofiled_fresh_provider_inverse_runs_same_fixture_no_concurrent_heavy_test',rows=rows,median_seconds=statistics.median(r['seconds'] for r in rows))\nPath(sys.argv[1]).write_text(json.dumps(result,indent=2)+'\\n')\nprint(result['median_seconds'],result['water_module'])\n",
